[Unit]
Description=NEXU-OS local FastAPI event service
After=local-fs.target
ConditionPathExists=/opt/nexus-os/core/local_server.py

[Service]
Type=simple
User=nexus-svc
Group=nexus-svc
WorkingDirectory=/opt/nexus-os
StateDirectory=nexus-os
StateDirectoryMode=0750
ExecStart=/usr/bin/python3 -m core.local_server
Restart=on-failure
RestartSec=3s
TimeoutStopSec=15s
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ReadWritePaths=/var/lib/nexus-os
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
UMask=0027

[Install]
WantedBy=multi-user.target
