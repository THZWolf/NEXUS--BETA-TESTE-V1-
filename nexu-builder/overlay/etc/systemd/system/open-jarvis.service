[Unit]
Description=OpenJarvis optional local assistant
After=nexus-server.service
Wants=nexus-server.service
ConditionPathIsExecutable=/opt/openjarvis/.venv/bin/jarvis

[Service]
Type=simple
User=openjarvis
Group=openjarvis
WorkingDirectory=/opt/openjarvis
Environment=HOME=/opt/openjarvis
ExecStart=/opt/openjarvis/.venv/bin/jarvis serve --host 127.0.0.1 --port 8000
Restart=on-failure
RestartSec=5s
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ReadWritePaths=/opt/openjarvis
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6

[Install]
WantedBy=multi-user.target
